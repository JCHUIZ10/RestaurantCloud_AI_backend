# ==============================================================================
# ENTORNO GENERAL
# ==============================================================================
APP_ENV=development
APP_PORT=8080

# ==============================================================================
# POSTGRESQL (Contenedor Docker y Motor)
# ==============================================================================
POSTGRES_DB=restaurantcloud_db
POSTGRES_USER=saas_admin
POSTGRES_PASSWORD=123
POSTGRES_PORT=5432

# ==============================================================================
# CONEXIÓN DE BASE DE DATOS (Backend Go)
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=saas_admin
DB_PASSWORD=123
DB_NAME=restaurantcloud_db
DB_SSLMODE=disable

# DSN unificado (útil para herramientas de conexion)
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=${DB_SSLMODE}

# ==============================================================================
# REDIS (Contenedor Docker, Sesiones, Tokens Efímeros, Rate Limit y Caché)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=rC_redis_secret_2026!
REDIS_DB=0

# ==============================================================================
# MINIO (Almacenamiento de Objetos S3 Compatible - Desarrollo Local)
# ==============================================================================
MINIO_ROOT_USER=saas_minio_admin
MINIO_ROOT_PASSWORD=rC_minio_secret_2026!
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DEFAULT_BUCKET=restaurantcloud

# ==============================================================================
# STRIPE BILLING (Pasarela de Suscripciones SaaS - Modo Real Oficial)
# ==============================================================================
STRIPE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
