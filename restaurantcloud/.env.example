# ==============================================================================
# ENTORNO GENERAL
# ==============================================================================
APP_ENV=development
APP_PORT=8080

# ==============================================================================
# POSTGRESQL (Contenedor Docker y Motor)
# ==============================================================================
POSTGRES_DB=restaurantcloud_db
POSTGRES_USER=saas_admin
POSTGRES_PASSWORD=123
POSTGRES_PORT=5432

# ==============================================================================
# REDIS (Contenedor Docker, Sesiones, Tokens Efímeros, Rate Limit y Caché)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=rC_redis_secret_2026!
REDIS_DB=0

# ==============================================================================
# MINIO (Almacenamiento de Objetos S3 Compatible - Desarrollo Local)
# ==============================================================================
MINIO_ROOT_USER=saas_minio_admin
MINIO_ROOT_PASSWORD=rC_minio_secret_2026!
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DEFAULT_BUCKET=restaurantcloud
# URL pública (navegador) del prefijo catalogo/ para fotos de la carta digital.
AWS_URL=http://localhost:9000/restaurantcloud


# ==============================================================================
# MICROSERVICIOS — una base de datos por servicio (valores solo para desarrollo local)
# ==============================================================================
# ms-analítica (PostgreSQL)
ANALITICA_DB_NAME=analitica_db
ANALITICA_DB_USER=analitica_admin
ANALITICA_DB_PASSWORD=dev_analitica_123
ANALITICA_DB_PORT=5433
# Usuario con el que el servicio se conecta (sin privilegios de administración).
# Lo crea infra/postgres/analitica/01-usuarios.sh al inicializar el volumen.
ANALITICA_DB_APP_USER=analitica_app
ANALITICA_DB_APP_PASSWORD=cambiar_en_local

# ms-pronóstico (PostgreSQL)
PRONOSTICO_DB_NAME=pronostico_db
PRONOSTICO_DB_USER=pronostico_admin
PRONOSTICO_DB_PASSWORD=dev_pronostico_123
PRONOSTICO_DB_PORT=5434
# Usuario con el que ms-pronóstico se conecta (sin privilegios de administración).
# Lo crea infra/postgres/pronostico/01-usuarios.sh al inicializar el volumen.
PRONOSTICO_DB_APP_USER=pronostico_app
PRONOSTICO_DB_APP_PASSWORD=cambiar_en_local
PRONOSTICO_PORT=8002

# ms-notificaciones (MongoDB)
NOTIFICACIONES_MONGO_DB=notificaciones_db
NOTIFICACIONES_MONGO_USER=notificaciones_admin
NOTIFICACIONES_MONGO_PASSWORD=dev_notificaciones_123
NOTIFICACIONES_MONGO_PORT=27017

# Destinos de los eventos del núcleo (outbox). Un destino sin URL se omite:
# el núcleo funciona aunque el microservicio no esté levantado.
# El secreto firma cada envío (HMAC-SHA256) y debe coincidir con el SECRETO_INTERNO del servicio.
ANALITICA_URL=http://analitica:8001
ANALITICA_SECRETO=dev_secreto_analitica_123
PRONOSTICO_URL=http://pronostico:8002
PRONOSTICO_SECRETO=dev_secreto_pronostico_123
# Reserva mínima de la reposición en los días sin modelo propio (fracción de lo más probable; 0.35 = 35 %)
PREDICCION_RESERVA_MINIMA=0.35
NOTIFICACIONES_URL=
NOTIFICACIONES_SECRETO=dev_secreto_notificaciones_123

# ==============================================================================
# STRIPE BILLING (Pasarela de Suscripciones SaaS - Modo Real Oficial)
# ==============================================================================
STRIPE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
