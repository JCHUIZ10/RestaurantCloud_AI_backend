# API Backend Base URL (dejar vacío para usar el proxy local /api/v1 definido en vite.config.ts)
VITE_API_URL=

# false (predeterminado): usa mocks en memoria; los cambios se pierden al recargar.
# true: usa Laravel en los flujos ya integrados; requiere Docker API activo y los cambios persisten y se mantienen en PostgreSQL.
# Reinicia Vite tras modificar esta variable si no se recarga automáticamente.
VITE_USE_REAL_API=false
VITE_STRIPE_PUBLIC_KEY=pk_test_...

