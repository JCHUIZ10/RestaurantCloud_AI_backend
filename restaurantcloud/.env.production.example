# ==============================================================================
# Plantilla de entorno para Producción (docker-compose.prod.yml)
# Generado automáticamente con: ./scripts/generar-env.sh produccion
#   (o .\scripts\generar-env.ps1 produccion)
# Sin dominio propio se puede usar sslip.io, p. ej. https://app.203-0-113-10.sslip.io
# Nunca subir el .env real a Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dominio, URLs públicas y Caddy (HTTPS automático con Let's Encrypt)
# ------------------------------------------------------------------------------
SITIO=https://app.tudominio.com
FILES_DOMAIN=files.tudominio.com
APP_ENV=production
APP_URL=https://app.tudominio.com
FRONTEND_URL=https://app.tudominio.com
KONG_CORS_ORIGENES=https://app.tudominio.com
SESSION_SECURE_COOKIE=true
LOG_LEVEL=warning
OCTANE_WORKERS=4

# ------------------------------------------------------------------------------
# 2. Núcleo Laravel (APP_KEY y claves RSA JWT entre servicios)
# ------------------------------------------------------------------------------
# Generar APP_KEY al azar (base64:...) y las claves JWT con: php artisan jwt:claves
APP_KEY=
JWT_EMISOR=restaurantcloud-nucleo
JWT_MINUTOS=10
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# ------------------------------------------------------------------------------
# 3. Base de datos principal (PostgreSQL) y Redis
# ------------------------------------------------------------------------------
POSTGRES_DB=restaurantcloud_db
POSTGRES_USER=saas_admin
POSTGRES_PASSWORD=
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE=1GB

REDIS_PASSWORD=
REDIS_MAXMEMORY=128mb

# ------------------------------------------------------------------------------
# 4. Almacenamiento de archivos (MinIO / S3 detrás de Caddy FILES_DOMAIN)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=saas_minio_admin
MINIO_ROOT_PASSWORD=
MINIO_CONSOLE_PORT=9001
MINIO_DEFAULT_BUCKET=restaurantcloud
AWS_URL=https://files.tudominio.com/restaurantcloud
AWS_TEMPORARY_URL=https://files.tudominio.com

# ------------------------------------------------------------------------------
# 5. Correo SMTP (con MAIL_MAILER=log los correos quedan en el log del servidor)
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@tudominio.com
MAIL_FROM_NAME="ÁUREA"

# ------------------------------------------------------------------------------
# 6. Integraciones externas (Stripe y ApiPeru) - completar solo en el VPS
# ------------------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

APIDEV_BASE_URL=https://api.apiperu.dev
APIDEV_TOKEN=
APIDEV_MOCK=false

# ------------------------------------------------------------------------------
# 7. Microservicio Analítica (PostgreSQL + secreto HMAC compartido)
# ------------------------------------------------------------------------------
ANALITICA_DB_NAME=analitica_db
ANALITICA_DB_USER=analitica_migrador
ANALITICA_DB_PASSWORD=
ANALITICA_DB_APP_USER=analitica_app
ANALITICA_DB_APP_PASSWORD=
ANALITICA_SECRETO=

# ------------------------------------------------------------------------------
# 8. Microservicio Pronóstico (PostgreSQL + GCS + secreto HMAC compartido)
# ------------------------------------------------------------------------------
PRONOSTICO_DB_NAME=pronostico_db
PRONOSTICO_DB_USER=pronostico_migrador
PRONOSTICO_DB_PASSWORD=
PRONOSTICO_DB_APP_USER=pronostico_app
PRONOSTICO_DB_APP_PASSWORD=
PRONOSTICO_SECRETO=
PREDICCION_RESERVA_MINIMA=0.35
MODELOS_REPOSITORIO=gs://rc-modelos-demo-aurea
MODELOS_GCS_ANONIMO=true

# ------------------------------------------------------------------------------
# 9. Microservicio Notificaciones (MongoDB + secreto HMAC compartido)
# ------------------------------------------------------------------------------
NOTIFICACIONES_MONGO_DB=notificaciones_db
NOTIFICACIONES_MONGO_USER=notif_admin
NOTIFICACIONES_MONGO_PASSWORD=
NOTIFICACIONES_MONGO_APP_USER=notif_app
NOTIFICACIONES_MONGO_APP_PASSWORD=
NOTIFICACIONES_SECRETO=
NOTIFICACIONES_DIAS_RETENCION=30
