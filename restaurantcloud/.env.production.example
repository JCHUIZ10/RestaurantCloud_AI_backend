# Copiar a .env en el VPS y completar. Generar secretos con: openssl rand -hex 24
# Sin dominio propio: usar sslip.io, p. ej. APP_DOMAIN=app.203-0-113-10.sslip.io

APP_DOMAIN=app.tudominio.com
FILES_DOMAIN=files.tudominio.com
LOG_LEVEL=warning
OCTANE_WORKERS=4

POSTGRES_DB=restaurantcloud_db
POSTGRES_USER=saas_admin
POSTGRES_PASSWORD=

REDIS_PASSWORD=

MINIO_ROOT_USER=saas_minio_admin
MINIO_ROOT_PASSWORD=
MINIO_DEFAULT_BUCKET=restaurantcloud

STRIPE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

APIDEV_TOKEN=

# SMTP (opcional hoy; sin esto los correos van al log)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@tudominio.com
