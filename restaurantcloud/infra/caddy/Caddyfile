{$SITIO} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy kong:8000 {
			# SSE (KDS y notificaciones): entregar eventos sin buffer.
			flush_interval -1
			# No confiar en X-Forwarded-For enviado por el cliente.
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}

	handle /up {
		reverse_proxy kong:8000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}

	# En QA (sin segundo dominio), MinIO se sirve bajo /<bucket>/* en el mismo origen.
	handle /{$MINIO_DEFAULT_BUCKET:restaurantcloud}/* {
		@catalogo path /{$MINIO_DEFAULT_BUCKET:restaurantcloud}/catalogo/*
		header @catalogo Cache-Control "public, max-age=31536000, immutable"

		reverse_proxy minio:9000 {
			header_up Host minio:9000
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# Producción: dominio dedicado para descargas firmadas de MinIO.
# En QA, el valor por defecto interno evita que Caddy exija un segundo dominio o certificado.
{$FILES_DOMAIN:http://127.0.0.1:8090} {
	@catalogo path /{$MINIO_DEFAULT_BUCKET:restaurantcloud}/catalogo/*
	header @catalogo Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy minio:9000 {
		header_up Host minio:9000
	}
}
