# Variables de entorno de ms-pronóstico (valores de ejemplo para desarrollo local).
# En Docker Compose se definen en docker-compose.yml a partir del .env de la raíz.

PORT=8002
# Conexión con el usuario de la aplicación (sin privilegios de administración).
DATABASE_URL=postgresql+psycopg://pronostico_app:cambiar_en_local@localhost:5434/pronostico_db
# Secreto HMAC de /interno; debe coincidir con PRONOSTICO_SECRETO del núcleo.
SECRETO_INTERNO=cambiar_en_local
ZONA_HORARIA=America/Lima
# Repositorio de modelos: file:// hoy, gs:// en la etapa 8. En local, la carpeta de model-ia.
MODELOS_REPOSITORIO=file:///j:/proyectos_git/RestaurantCloud_AI_backend/model-ia/repositorio

# Solo para migraciones y pruebas: conexión del usuario administrador y nombre del usuario de la
# aplicación, al que la migración 0002 concede sus permisos.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://pronostico_admin:dev_pronostico_123@localhost:5434/pronostico_db
APP_DB_USER=pronostico_app
# Base de pruebas (la crea infra/postgres/pronostico/01-usuarios.sh). Las pruebas necesitan las dos:
# el administrador aplica las migraciones y limpia las tablas; la aplicación es el usuario real del servicio.
TEST_DATABASE_URL=postgresql+psycopg://pronostico_admin:dev_pronostico_123@localhost:5434/pronostico_db_test
TEST_APP_DATABASE_URL=postgresql+psycopg://pronostico_app:cambiar_en_local@localhost:5434/pronostico_db_test
