# Variables de entorno de ms-analítica (valores de ejemplo para desarrollo local).
# En Docker Compose se definen en docker-compose.yml a partir del .env de la raíz.

PORT=8001
# Conexión con el usuario de la aplicación (sin privilegios de administración).
DATABASE_URL=postgresql+psycopg://analitica_app:cambiar_en_local@localhost:5433/analitica_db
# Secreto HMAC de /interno; debe coincidir con ANALITICA_SECRETO del núcleo.
SECRETO_INTERNO=cambiar_en_local
ZONA_HORARIA=America/Lima

# Solo para migraciones y pruebas: conexión del usuario administrador.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://analitica_admin:cambiar_en_local@localhost:5433/analitica_db
# Base de pruebas (la crea infra/postgres/analitica/01-usuarios.sh). Las pruebas necesitan las dos:
# el administrador aplica las migraciones y limpia las tablas; la aplicación es el usuario real del servicio.
TEST_DATABASE_URL=postgresql+psycopg://analitica_admin:cambiar_en_local@localhost:5433/analitica_db_test
TEST_APP_DATABASE_URL=postgresql+psycopg://analitica_app:cambiar_en_local@localhost:5433/analitica_db_test
