# Variables de entorno de ms-notificaciones (sin valores reales).
# En Docker las pasa el compose; este archivo sirve para ejecutar el servicio desde el host
# (`npm run dev`) con el MongoDB del compose publicado en el puerto 27017.

PORT=8003
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=notificaciones_db
# Usuario de la aplicación (lo crea infra/mongo/notificaciones/01-usuario.js); sin privilegios de administración.
MONGODB_USUARIO=notificaciones_app
MONGODB_CLAVE=
# Base donde está definido el usuario; por defecto, MONGODB_DB.
# MONGODB_AUTH_SOURCE=notificaciones_db

# Secreto HMAC de /interno: el NOTIFICACIONES_SECRETO del núcleo.
SECRETO_INTERNO=

# Clave pública con la que se validan los JWT (la misma del núcleo), con "\n" literales si va en una línea.
JWT_PUBLIC_KEY=
# JWT_EMISOR=restaurantcloud-nucleo
# JWT_AUDIENCIA=restaurantcloud-servicios

DIAS_RETENCION=30
# LATIDO_SEGUNDOS=25
# ZONA_HORARIA=America/Lima

# Pruebas (`npm test`): MongoDB real del compose, base notificaciones_db_test.
# El administrador aplica el esquema; el usuario de la aplicación ejecuta las pruebas.
TEST_MONGODB_URI=mongodb://localhost:27017
TEST_MONGODB_ADMIN_USUARIO=notificaciones_admin
TEST_MONGODB_ADMIN_CLAVE=
TEST_MONGODB_APP_USUARIO=notificaciones_app
TEST_MONGODB_APP_CLAVE=
